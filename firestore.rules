rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só o usuário autenticado (login único do dono da Brag Truck) pode ler/escrever.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'joao.reis@bragtruck.local';
    }
  }
}
