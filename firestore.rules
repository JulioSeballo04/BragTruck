rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O app não tem autenticação de usuário, então liberamos leitura/escrita geral.
    // Sem essa regra o Firestore bloqueia tudo por padrão e o app não salva nada.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
